# Copy to .env for LOCAL testing only (never commit .env).
# In GitHub Actions these come from repository Secrets instead.
#
# Load them in your shell, e.g.:  set -a; source .env; set +a

# Google AI Studio API key (use a project WITHOUT billing enabled to stay on the free tier)
GEMINI_API_KEY=your-gemini-api-key-here

# Telegram bot token from @BotFather. Recipients are whoever presses Start
# in the bot (you and your friends); no chat id is configured.
TELE_BOT_TOKEN=123456789:your-telegram-bot-token-here

# Optional but recommended: a private invite code (8-64 chars: A-Z a-z 0-9 _ -).
# Share https://t.me/<your_bot_username>?start=<this code> with your friends.
# If empty, anyone who finds the bot can join (up to telegram.max_subscribers).
BOT_INVITE_CODE=change-me-to-a-random-code

# Optional overrides
# GEMINI_MODEL=gemini-3.8-flash
# LLM_PROVIDER=gemini        # gemini | mock | ollama
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_BASE_URL=http://localhost:11434
